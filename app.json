{
  "expo": {
    "name": "Mistik Rehber",
    "slug": "mistik-rehber",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0A1F"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0A1F"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Fal yorumu için fotoğraflarına erişim izni gerekiyor.",
          "cameraPermission": "Fal yorumu için fotoğraf çekmek üzere kameraya erişim izni gerekiyor."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Sesli fal için mikrofonuna erişim izni gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2C879"
        }
      ]
    ]
  }
}