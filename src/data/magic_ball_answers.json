[
  "Evet, kesinlikle.",
  "Şüphesiz öyle.",
  "Evrenin cevabı: evet.",
  "Güven bana, evet.",
  "Görünen o ki evet.",
  "Şu an için evet diyebilirim.",
  "Olasılıklar senden yana, evet.",
  "İçindeki ses de aynı şeyi söylüyor: evet.",
  "Şimdi söylemek zor, sonra tekrar sor.",
  "Şu an odaklan, sonra tekrar sor.",
  "Cevap sisler içinde, biraz bekle.",
  "Şu an içinde net değil, tekrar dene.",
  "Şu anki enerji belirsiz, sabret.",
  "Sanmıyorum.",
  "Cevabım hayır.",
  "Güvenme buna.",
  "Görünüşe göre hayır.",
  "Kaynaklar hayır diyor.",
  "Beklediğin gibi olmayabilir.",
  "Şu an için pek olası görünmüyor."
]
